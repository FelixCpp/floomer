# Root .gitignore for the floomer monorepo.
# Per-package rules live in packages/<name>/.gitignore
# (e.g. packages/floomer_app/.gitignore, generated by `flutter create`).

# OS
.DS_Store
Thumbs.db

# Editors / IDEs
*.iml
*.ipr
*.iws
.idea/
.atom/
.history
*.swp
# Uncomment if you don't want to share launch configs and tasks:
#.vscode/

# Logs & temp
*.log
.buildlog/

# Dart / Flutter / Pub
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub/
.pub-cache/
.pub-preload-cache/
build/
coverage/
**/doc/api/
.fvm/
.widget_preview/
migrate_working_dir/

# Dependency locks (apps as well as packages)
*.lock

# Generated plugin registrants
**/generated_plugin_registrant.dart
**/android/**/GeneratedPluginRegistrant.java
**/ios/Runner/GeneratedPluginRegistrant.*
**/macos/Flutter/GeneratedPluginRegistrant.swift
**/windows/flutter/generated_plugin_registrant.cc
**/windows/flutter/generated_plugin_registrant.h
**/windows/flutter/generated_plugins.cmake
**/linux/flutter/generated_plugin_registrant.cc
**/linux/flutter/generated_plugin_registrant.h
**/linux/flutter/generated_plugins.cmake

# Symbolication / obfuscation
app.*.symbols
app.*.map.json

# Android
**/android/**/gradle-wrapper.jar
.gradle/
**/android/captures/
**/android/gradlew
**/android/gradlew.bat
**/android/local.properties
**/android/key.properties
*.jks

# iOS / macOS / Xcode
**/Flutter/ephemeral/
**/Pods/
**/dgph
**/xcuserdata/
**/ios/**/*.mode1v3
**/ios/**/*.mode2v3
**/ios/**/*.moved-aside
**/ios/**/*.pbxuser
**/ios/**/*.perspectivev3
**/ios/**/*sync/
**/ios/**/.sconsign.dblite
**/ios/**/.tags*
**/ios/**/.vagrant/
**/ios/**/DerivedData/
**/ios/**/.symlinks/
**/ios/**/profile
**/ios/.generated/
**/ios/Flutter/.last_build_id
**/ios/Flutter/App.framework
**/ios/Flutter/Flutter.framework
**/ios/Flutter/Flutter.podspec
**/ios/Flutter/Generated.xcconfig
**/ios/Flutter/app.flx
**/ios/Flutter/app.zip
**/ios/Flutter/flutter_assets/
**/ios/Flutter/flutter_export_environment.sh
**/ios/ServiceDefinitions.json

# Exceptions
!**/ios/**/default.mode1v3
!**/ios/**/default.mode2v3
!**/ios/**/default.pbxuser
!**/ios/**/default.perspectivev3
